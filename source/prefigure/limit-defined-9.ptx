<diagram dimensions="(300,300)" margins="5" xmlns="https://prefigure.org">

    <definition>f(x) = x^2-4*x+4</definition>

    <coordinates bbox="[-0.3,-0.3,4,4]">
        <axes xlabel="\alpha" ylabel="h(\alpha)"
            hticks="(0,1,4)" hlabels="(0,1,4)" 
            vticks="(0,1,4)" vlabels="(0,1,4)"
            arrows="0"/>
        <line at="guide" endpoints="((2,0),(2,4))" stroke="blue" />
        <graph at="graph_left" function="f" domain="(0,1.95)" stroke="lightgreen" thickness="2" />
        <point at="jump" p="(2,2)" size="4" fill = "lightgreen" thickness="1" />
        <point p="(2,0)" size="4" fill = "white" thickness="1" />
        <graph at="graph_right" function="f" domain="(2.05,4)" stroke="lightgreen" thickness="2" />
    </coordinates>

    <annotations>
        <annotation ref="figure" text="The graph of a function">
            <annotation ref="graph_left" text="The curve begins at the top left and descends toward 0 at alpha = 2." sonify="yes" />
            <annotation ref="jump" text="At alpha = 2 there is a single point at a height of 2." />
            <annotation ref="graph_right" text="To the right of this it is a mirror image of the left." sonify="yes" />
            <annotation ref="guide" text="Vertical line at alpha equals 2 guiding you toward the curve" />
        </annotation>
    </annotations>

</diagram>
