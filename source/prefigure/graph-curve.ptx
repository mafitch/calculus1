<diagram dimensions="(300,300)" margins="5" xmlns="https://prefigure.org">

  <definition>f(x) = x*(x - 4)/(x + 2)</definition>

  <coordinates bbox="[-8,-80,8,60]">
      <axes 
          hticks="(-8,1,8)" hlabels="(-8,2,8)" 
          vticks="(-80,10,60)" vlabels="(-80,20,60)"
          arrows="0"/>
      <graph at="graph_left" function="f" domain="(-8,-2)" stroke="blue" thickness="2" />
      <graph at="graph_right" function="f" domain="(-2,8)" stroke="blue" thickness="2" />
  </coordinates>

  <annotations>
      <annotation ref="figure" text="The graph of a rational function">
          <annotation ref="graph_left" text="From the left the graph briefly climbs slowly before plummeting toward negative infinity before x=-2." sonify="yes" />
          <annotation ref="graph_right" text="To the right of x=-2, it reappears descending from infinity rapidly before beginning a slow climb." sonify="yes" />
      </annotation>
  </annotations>

</diagram>