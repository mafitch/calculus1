<diagram dimensions="(300,300)" margins="5" xmlns="https://prefigure.org">

  <definition>f(x) = 9/50*x^5 - 153/40*x^4 + 57/2*x^3 - 1791/20*x^2 + 108*x + 45</definition>

  <coordinates bbox="[-1.2,-8,10,100]">
      <axes 
          hticks="(0,1,10)" hlabels="(0,2,10)" 
          vticks="(0,10,100)" vlabels="(0,20,100)"
          arrows="0"/>
      <graph at="graph" function="f" stroke="blue" thickness="2" />
      <line at="guide_left" endpoints="((1/2,0),(1/2,100))" stroke="lightgreen" dash="6 6" />
      <line at="guide_right" endpoints="((9.2,0),(9.2,100))" stroke="lightgreen" dash="6 6" />
  </coordinates>

  <annotations>
      <annotation ref="figure" text="The graph of a function with an interval marked by vertical lines">
          <annotation ref="graph" text="From the left the graph is climbing as it crosses the left end of the interval. It rises, descends, and then rises again. Before reaching the height of the first rise, it begins to descend again. It continues to descend going lower than it was when it crossed the left end of the interval. Then it begins rising rapidly meeting the right endpoint at a height higher than any of the previous peaks." sonify="yes" />
          <annotation ref="guide_left" text="The left end of the interval is marked by a vertical line at x = 1/2. It crosses the curve at just below y=80." sonify="yes" />
          <annotation ref="guide_right" text="The right end of the interval is marked by a vertical line at x = 9.2. It crosses the curve at between y=60 and y=70." sonify="yes" />
=      </annotation>
  </annotations>

</diagram>