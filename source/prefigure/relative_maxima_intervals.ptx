<diagram dimensions="(300,300)" margins="5" xmlns="https://prefigure.org">

  <definition>f(x) = -x*(x - 1)*(x - 4)*(x - 6)</definition>

  <coordinates bbox="[-1,-20,7,25]">
      <axes 
          hticks="(0,0.5,7)" hlabels="(0,1,7)" 
          vticks="(-20,5,25)" vlabels="(-20,10,20)"
          arrows="0"/>
      <graph at="graph" function="f" stroke="blue" thickness="2" />
      <point at="point1" p="(0.443108570,f(0.443108570))" size="4" color="red" />
      <point at="point2" p="(5.205823905,f(5.205823905))" size="4" color="red" />
  </coordinates>

  <annotations>
      <annotation ref="figure" text="The graph of a function with two relative maxima marked by points">
          <annotation ref="graph" text="From the left the graph rises to a peak at about y=5 before x=0.5. Then it falls to a low near x=2.5. It rises to another peak above y=20 near x=5, then falls again." sonify="yes" />
          <annotation ref="point1" text="A point at the high point at about y=5 near x=0.5." sonify="yes" />
          <annotation ref="point2" text="A point at the high point at about y=20 near x=5.5." sonify="yes" />
      </annotation>
  </annotations>

</diagram>