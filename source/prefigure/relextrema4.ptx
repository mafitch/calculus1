<diagram dimensions="(300,300)" margins="5" xmlns="https://prefigure.org">

  <definition>f(x) = cot(x)</definition>

  <coordinates bbox="[-1.5,-15,2*pi,15]">
      <axes h-pi-format="yes"
          hticks="(0,pi/8,2*pi)" hlabels="(0,pi/4,2*pi)" 
          vticks="(-15,1,15)" vlabels="(-15,5,15)"
          arrows="0"/>
      <graph at="graph" function="f" domain="0,2*pi" stroke="blue" thickness="2" />
  </coordinates>

  <annotations>
      <annotation ref="figure" text="The graph of a function">
          <annotation ref="graph" text="The graph descends from positive infinity at x=0, then slows its descent approaching x=pi/2, then it descends rapidly toward negative infinity as x approaches pi. It repeats this pattern in the interval (pi, 2*pi)." sonify="yes" />
      </annotation>
  </annotations>

</diagram>