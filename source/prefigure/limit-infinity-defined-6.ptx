<diagram dimensions="(300,300)" margins="5" xmlns="https://prefigure.org">

    <definition>f(x) = sin(x)/x</definition>

    <coordinates bbox="[-8*pi,-0.3,8*pi,1]">
        <axes xlabel="x" ylabel="h(x)"
            h-pi-format="yes"
            hticks="(-8*pi,pi,8*pi)" hlabels="(-8*pi,2*pi,8*pi)" 
            vticks="(-0.2,0.1,1.0)" vlabels="(-0.2,0.2,1.0)"
            arrows="0"/>
        <graph at="graph" function="f" domain="(-8*pi,8*pi)" stroke="lightgreen" thickness="2" />
    </coordinates>

    <annotations>
        <annotation ref="figure" text="The graph of a function">
            <annotation ref="graph" text="On the right the curve appears below the x axis and bounces up and down with increasing height until it reaches a height of y=1 at x=0. The left side is the reflection of the right side over the y axis." sonify="yes" />
        </annotation>
    </annotations>

</diagram>
