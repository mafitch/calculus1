<diagram dimensions="(300,300)" margins="5" xmlns="https://prefigure.org">

    <definition>f(x) = 1/((x + 2)*(x - 2))</definition>

    <coordinates bbox="[-4,-3,4,3]">
        <axes xlabel="x" ylabel="f(x)"
            hticks="(-4,1,4)" hlabels="(-4,2,4)" 
            vticks="(-3,1,3)" vlabels="(-3,1,3)"
            arrows="0"/>
        <graph at="graph_1" function="f" domain="(-4,-2)" stroke="lightgreen" thickness="2" />
        <graph at="graph_2" function="f" domain="(-2,2)" stroke="lightgreen" thickness="2" />
        <graph at="graph_3" function="f" domain="(2,4)" stroke="lightgreen" thickness="2" />
    </coordinates>

    <annotations>
        <annotation ref="figure" text="The graph of a function with three parts">
            <annotation ref="graph_1" text="On the left the graph begins near the x-axis then ascends rapidly toward infinity at x = -2." sonify="yes" />
            <annotation ref="graph_2" text="To the right of x = -2 the graph appears from negative infinity climbs almost to y=0 then descends toward negative infinity again at x=2." sonify="yes" />
            <annotation ref="graph_3" text="To the right of x=2 the graph appears from infinity and descends steeply before leveling off above the x-axis." sonify="yes" />
        </annotation>
    </annotations>

</diagram>