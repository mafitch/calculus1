<diagram dimensions="(300,300)" margins="5" xmlns="https://prefigure.org">

  <definition>f(x) = abs(sin(x))</definition>

  <coordinates bbox="[-1.5,-0.1,4*pi,1]">
      <axes h-pi-format="yes"
          hticks="(0,pi/8,4*pi)" hlabels="(0,pi/2,4*pi)" 
          vticks="(0,0.1,1)" vlabels="(0,0.2,1)"
          arrows="0"/>
      <graph at="graph" function="f" domain="0,4*pi" stroke="blue" thickness="2" />
  </coordinates>

  <annotations>
      <annotation ref="figure" text="The graph of a function">
          <annotation ref="graph" text="The graph rises from y=0 to a height of 1 then falls back to 0. This is repeated four times, symmetrically from 0 to 4 pi." sonify="yes" />
      </annotation>
  </annotations>

</diagram>