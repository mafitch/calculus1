<diagram dimensions="(300,300)" margins="5" xmlns="https://prefigure.org">

  <definition>f(x) = 1/x</definition>

  <coordinates bbox="[-10,-10,10,10]">
      <axes xlabel="x" ylabel="f(x)"
          hticks="(-10,1,10)" hlabels="(-10,2,10)" 
          vticks="(-10,1,10)" vlabels="(-10,2,10)"
          arrows="0"/>
      <graph at="graph_left" function="f" domain="(-10,0)" stroke="lightgreen" thickness="2" />
      <graph at="graph_right" function="f" domain="(0,10)" stroke="lightgreen" thickness="2" />
  </coordinates>

  <annotations>
      <annotation ref="figure" text="The graph of a function">
          <annotation ref="graph_left" text="From the left the graph starts just below the x axis and descends increasingly rapidly toward negative infinity as it approaches x = 0." sonify="yes" />
          <annotation ref="graph_right" text="To the right of x=0, the curve reappears from infinity and descends rapidly toward the x axis." sonify="yes" />
      </annotation>
  </annotations>

</diagram>
