<diagram dimensions="(300,300)" margins="5" xmlns="https://prefigure.org">

  <definition>f(x) = 1/((x - 1)^2*(x - 2))</definition>

  <coordinates bbox="[-1.5,-20,4,30]">
      <axes xlabel="y" ylabel="g(y)"
          hticks="(0,1/2,4)" hlabels="(0,1,4)"
          vticks="(-20,5,30)" vlabels="(-20,10,30)" 
          arrows="0"/>
      <graph at="graph_left" function="f" domain="(0,1)" stroke="lightgreen" thickness="2" />
      <graph at="graph_center" function="f" domain="(1,2)" stroke="lightgreen" thickness="2" />
      <graph at="graph_right" function="f" domain="(2,4)" stroke="lightgreen" thickness="2" />
  </coordinates>

  <annotations>
      <annotation ref="figure" text="The graph of a function">
          <annotation ref="graph_left" text="From the left the graph begins below zero and descends toward negative infinity at x=1." sonify="yes" />
          <annotation ref="graph_center" text="To the right of x=1 it climbs above y=-10 then descends to negative infnity again at x=2." sonify="yes" />
          <annotation ref="graph_right" text="To the right of x=2 it descencds from infinity and levels off above the x axis." sonify="yes" />
      </annotation>
  </annotations>

</diagram>
