<diagram dimensions="(300,300)" margins="5" xmlns="https://prefigure.org">

  <definition>f(x) = 1/(x*(x - 1)*(x - 2))</definition>

  <coordinates bbox="[-0.2,-45,2,45]">
      <axes 
          hticks="(0,0.1,2)" hlabels="(0,0.5,2)" 
          vticks="(-40,5,40)" vlabels="(-40,10,40)"
          arrows="0"/>
      <graph at="graph" function="f" domain="(0,2)" stroke="blue" thickness="2" />
  </coordinates>

  <annotations>
      <annotation ref="figure" text="The graph of a function">
          <annotation ref="graph" text="The graph descends sharply from infinity at x=0then levels off mostly before x=0.3. Starting after x=0.8, it rises rapidly again toward infinity at x=1. After x=1 it rises rapidly from negative infinity to mostly level off by about x=1.3. Starting after 1.8 it descends rapidly toward negative infinity again." sonify="yes" />
      </annotation>
  </annotations>

</diagram>