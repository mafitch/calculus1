<diagram dimensions="(300,300)" margins="5" xmlns="https://prefigure.org">

    <definition>f(x) = -(x + 2)*(x - 3)/((x - 1)*(x + 1))</definition>

    <coordinates bbox="[-3,-20,3,20]">
        <axes xlabel="\gamma" ylabel="f(\gamma)"
            hticks="(-3,1,3)" hlabels="(-3,1,3)" 
            vticks="(-20,5,20)" vlabels="(-20,5,20)"
            arrows="0"/>
        <line at="guide" endpoints="((1,-20),(1,20))" stroke="blue" />
        <graph at="graph_left" function="f" domain="(-3,-1)" stroke="lightgreen" thickness="2" />
        <graph at="graph_center" function="f" domain="(-1,1)" stroke="lightgreen" thickness="2" />
        <graph at="graph_right" function="f" domain="(1,3)" stroke="lightgreen" thickness="2" />
    </coordinates>

    <annotations>
        <annotation ref="figure" text="The graph of a function">
            <annotation ref="graph_left" text="The graph begins climbing shallowly from the left, then becomes almost vertical heading toward infinity at gamma = -1." sonify="yes" />
            <annotation ref="graph_center" text="The graph continues to the right of gamma = -1 by climbing from negative infinity almost vertically until it levels off at something less than -5 then descends to almost vertical at gamma = 1." sonify="yes" />
            <annotation ref="graph_right" text="The graph continues to the right of gamma = 1, by descending almost vertically from positive infinity and eventually begins leveling off." sonify="yes" />
            <annotation ref="guide" text="Vertical line at gamma equal 2 guiding you to the curve" />
        </annotation>
    </annotations>

</diagram>
