<diagram dimensions="(300,300)" margins="5" xmlns="https://prefigure.org">

  <definition>f(x) = 2*x-x^2</definition>

  <coordinates bbox="[-0.3,-0.1,2,1]">
      <axes 
          hticks="(0,1,2)" hlabels="(0,1,2)" 
          vticks="(0,0.05,1)" vlabels="(0,0.2,1)"
          arrows="0"/>
      <riemann-sum at="rect" function="f" domain="(0,2)" rule="lower"
                 N="4" fill="gray" stroke="black"/>
      <graph at="graph" function="f" domain="(0,2)" stroke="red" thickness="2" />
  </coordinates>

  <annotations>
      <annotation ref="figure" text="The graph of a function with rectangles approximating the area." >
          <annotation ref="rect" text="The first rectangle has height zero; it's top left corner touches the curve at the origin. The second rectangle has height about 0.75. Only it's top left corner touches the curve; the rest of it is below the curve. The third rectangle has height about 0.75. Only it's top right corner touches the curve; the rest of it is below the curve. The fourth rectangle has height 0 touching the curve at its top right corner." />
          <annotation ref="graph" text="From the left the graph climbs from the origin to y=1 at x=1. It then descends symmetric to its climb." sonify="yes" />
      </annotation>
  </annotations>

</diagram>