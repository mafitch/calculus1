<figure xml:id="interactive-slope-one-point">
    <caption>Illustrating the Slope of One Point</caption>
    <interactive platform="geogebra" width="100%" aspect="4:3">
        <slate xml:id="geogebra-slope-one-point" surface="geogebra" material="vkrv2pen" aspect="4:3">
                setCoordSystem(0, 2, -3, 1);
                enableShiftDragZoom(true);
        </slate>
        <instructions>
            <p>Move the point labeled C to see the change in slope matching those in the table you constructed.</p>
        </instructions>
    </interactive>
</figure>


