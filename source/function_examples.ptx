<figure xml:id="interactive-slope-one-point-polynomial">
    <caption>Illustrating the Slope of One Point (Polynomial)</caption>
    <interactive platform="geogebra" width="100%" aspect="4:3" preview="images/slope-one-point-polynomial.png" label="interactive-slope-one-point-polynomial">
        <slate xml:id="geogebra-slope-one-point-polynomial" surface="geogebra" material="tz7pgd2h" aspect="4:3">
                setCoordSystem(0, 2, -4, 1);
                enableShiftDragZoom(true);
        </slate>
        <instructions>
            <p>Move the point labeled C to see the change in slope matching those in the table you constructed.</p>
        </instructions>
    </interactive>
</figure>

